# Copy this file to .env for bare-metal / local runs:
#   cp .env.example .env
# For Docker, `docker compose up` reads this file for the POSTGRES_* values below.
# The app never needs database credentials baked into the image.

# --- PostgreSQL (required) ---------------------------------------------------
# For docker compose the API gets its own URL pointing at the `db` service.
# For manual runs, point this at any reachable PostgreSQL 14+ database.
DATABASE_URL=postgresql://gr8r:gr8r@localhost:5432/gr8r

# --- Server ----------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
DATA_DIR=.data

# Leave empty to generate one on first boot and store it in $DATA_DIR/config.json.
SESSION_SECRET=

# Set a token to protect the first-run setup wizard on a public server.
SETUP_TOKEN=

# Set to 1 when running behind an HTTPS reverse proxy.
TRUST_PROXY=0

# --- docker compose only ---------------------------------------------------
POSTGRES_USER=gr8r
POSTGRES_PASSWORD=gr8r
POSTGRES_DB=gr8r
