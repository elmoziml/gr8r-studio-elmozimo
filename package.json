{
  "name": "gr8r-studio-elmozimo",
  "version": "1.1.0",
  "private": true,
  "description": "Gr8r Elmoziml Studio: a calm, structured project management workspace.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"vite\" \"node --env-file=.env --watch server/index.js\"",
    "dev:web": "vite",
    "dev:server": "node --env-file=.env --watch server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:i18n": "node scripts/check-i18n.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:seed": "node --env-file=.env scripts/seed-db.mjs",
    "db:seed:reset": "node --env-file=.env scripts/seed-db.mjs --reset"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "lucide": "^0.460.0",
    "prettier": "^3.9.9",
    "vite": "^6.4.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "overrides": {
    "content-disposition": "0.5.4"
  }
}
